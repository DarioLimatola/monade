new file mode 100644
index 0000000..c506ab7
--- /dev/null
+++ b/tools/src/monade_tools/extract.py
@@ -0,0 +1,72 @@
+"""From the HTML of a Wikisource page to clean paragraphs of text.
+
+Removed: navigation boxes, headers and footers of the page, edit links, references
+and footnote markers, page numbers, tables of contents, hidden elements. Kept:
+paragraphs, verses (one paragraph per stanza, lines joined with newlines), headings.
+Text is normalised to Unicode NFC and whitespace is collapsed.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+
+from lxml import html as lhtml
+
+#: Elements removed with their content (classes and ids used by Wikisource).
+DROP_XPATH = " | ".join(
+    [
+        "//table",
+        "//style",
+        "//script",
+        "//sup[contains(@class,'reference')]",
+        "//ol[contains(@class,'references')]",
+        "//*[contains(@class,'ws-noexport')]",
+        "//*[contains(@class,'noprint')]",
+        "//*[contains(@class,'mw-editsection')]",
+        "//*[contains(@class,'pagenum')]",
+        "//*[contains(@class,'ws-pagenum')]",
+        "//*[contains(@class,'header_box')]",
+        "//*[contains(@class,'navbox')]",
+        "//*[@id='toc']",
+        "//*[contains(@class,'toc')]",
+        "//*[contains(@style,'display:none')]",
+        "//*[contains(@style,'display: none')]",
+    ]
+)
+
+BLOCKS = ("p", "h1", "h2", "h3", "h4", "h5", "h6", "dd", "li", "blockquote")
+
+
+def normalise(text: str) -> str:
+    """NFC, no soft hyphens, spaces collapsed (newlines kept inside verse)."""
+    text = unicodedata.normalize("NFC", text).replace("­", "")
+    lines = [re.sub(r"[ \t ]+", " ", line).strip() for line in text.split("\n")]
+    return "\n".join(line for line in lines if line)
+
+
+def paragraphs(page_html: str) -> list[str]:
+    """The paragraphs of a page, in order; empty if there is no text."""
+    if not page_html.strip():
+        return []
+    root = lhtml.fromstring(f"<div>{page_html}</div>")
+    for el in root.xpath(DROP_XPATH):
+        el.drop_tree()
+    out = []
+    # Verses: <div class="poem"><p>line<br>line</p></div> -> one paragraph per stanza.
+    for br in root.iter("br"):
+        br.tail = "\n" + (br.tail or "")
+    for el in root.iter(*BLOCKS):
+        # Only innermost blocks, so nothing is counted twice.
+        if any(child.tag in BLOCKS for child in el.iterdescendants()):
+            continue
+        text = normalise(el.text_content())
+        if len(text) >= 2:
+            out.append(text)
+    return out
+
+
+def is_index_page(paras: list[str]) -> bool:
+    """A page that is only a list of chapters (no prose of its own)."""
+    words = sum(len(p.split()) for p in paras)
+    return words < 40
diff --git a/tools/src/monade_tools/net.py b/tools/src/monade_tools/net.py
new file mode 100644
index 0000000..5836a42
--- /dev/null
+++ b/tools/src/monade_tools/net.py
@@ -0,0 +1,135 @@
+"""Polite fetching: one request at a time per host, a pause between requests, an honest
+User-Agent, a cache on disk (so a run can stop and resume without asking twice).
+
+Wikimedia APIs (Wikidata, Wikisource) are used as their API etiquette asks: serial
+requests, a descriptive User-Agent with a contact, `maxlag` on the MediaWiki API.
+robots.txt is checked for every other site.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+import urllib.robotparser
+from pathlib import Path
+from typing import Callable
+
+from . import __version__
+
+#: Hosts reached only through their documented APIs (API etiquette instead of robots.txt).
+API_HOSTS = (
+    "www.wikidata.org",
+    "query.wikidata.org",
+    "it.wikisource.org",
+    "de.wikisource.org",
+    "en.wikisource.org",
+)
+
+
+def user_agent() -> str:
+    """The User-Agent: name, version, and a contact (MONADE_CONTACT, or the project)."""
+    contact = os.environ.get("MONADE_CONTACT", "https://github.com/DarioLimatola/monade")
+    return f"monade-crawler/{__version__} ({contact}) python-urllib"
+
+
+class FetchError(Exception):
+    """A request that failed or was refused (robots.txt)."""
+
+
+class Fetcher:
+    """Fetches URLs politely, with a cache in `cache_dir`.
+
+    `get` returns the body as text. `opener` can be replaced in tests.
+    """
+
+    def __init__(
+        self,
+        cache_dir: Path,
+        pause: float = 1.0,
+        opener: Callable[[str, dict], bytes] | None = None,
+        offline: bool = False,
+    ):
+        self.cache_dir = cache_dir
+        self.pause = pause
+        self.opener = opener or self._urlopen
+        self.offline = offline
+        self.last: dict[str, float] = {}
+        self.robots: dict[str, urllib.robotparser.RobotFileParser] = {}
+        self.requests = 0
+        self.cache_hits = 0
+
+    def _cache_path(self, url: str) -> Path:
+        h = hashlib.sha256(url.encode("utf-8")).hexdigest()
+        return self.cache_dir / h[:2] / f"{h}.bin"
+
+    @staticmethod
+    def _urlopen(url: str, headers: dict) -> bytes:
+        req = urllib.request.Request(url, headers=headers)
+        with urllib.request.urlopen(req, timeout=60) as r:
+            return r.read()
+
+    def _allowed(self, url: str) -> bool:
+        parts = urllib.parse.urlsplit(url)
+        if parts.hostname in API_HOSTS:
+            return True
+        base = f"{parts.scheme}://{parts.netloc}"
+        rp = self.robots.get(base)
+        if rp is None:
+            rp = urllib.robotparser.RobotFileParser()
+            try:
+                body = self.opener(base + "/robots.txt", {"User-Agent": user_agent()})
+                rp.parse(body.decode("utf-8", "replace").splitlines())
+            except Exception:
+                rp.parse([])  # no robots.txt: allowed
+            self.robots[base] = rp
+        return rp.can_fetch(user_agent(), url)
+
+    def get(self, url: str) -> str:
+        """The body of `url` (from the cache if already fetched)."""
+        path = self._cache_path(url)
+        if path.is_file():
+            self.cache_hits += 1
+            return path.read_bytes().decode("utf-8")
+        if self.offline:
+            raise FetchError(f"offline and not cached: {url}")
+        if not self._allowed(url):
+            raise FetchError(f"refused by robots.txt: {url}")
+        host = urllib.parse.urlsplit(url).hostname or ""
+        wait = self.last.get(host, 0.0) + self.pause - time.monotonic()
+        if wait > 0:
+            time.sleep(wait)
+        headers = {"User-Agent": user_agent(), "Accept-Encoding": "identity"}
+        if host == "query.wikidata.org":
+            headers["Accept"] = "application/sparql-results+json"
+        tries = 0
+        while True:
+            try:
+                body = self.opener(url, headers)
+                break
+            except urllib.error.HTTPError as e:
+                tries += 1
+                # 429 (too many requests) and 503 (maxlag): wait and retry, at most 4 times.
+                if e.code in (429, 503) and tries <= 4:
+                    retry = e.headers.get("Retry-After") if e.headers else None
+                    time.sleep(float(retry) if retry and retry.isdigit() else 5.0 * tries)
+                    continue
+                raise FetchError(f"HTTP {e.code} for {url}") from e
+            except (urllib.error.URLError, TimeoutError, OSError) as e:
+                raise FetchError(f"{e} for {url}") from e
+            finally:
+                self.last[host] = time.monotonic()
+        self.requests += 1
+        path.parent.mkdir(parents=True, exist_ok=True)
+        tmp = path.with_suffix(".tmp")
+        tmp.write_bytes(body)
+        tmp.replace(path)  # a crash never leaves half a file in the cache
+        return body.decode("utf-8")
+
+    def get_json(self, url: str) -> dict:
+        """The body of `url`, parsed as JSON."""
+        return json.loads(self.get(url))
diff --git a/tools/src/monade_tools/wiki.py b/tools/src/monade_tools/wiki.py
new file mode 100644
index 0000000..553c4e7
--- /dev/null
+++ b/tools/src/monade_tools/wiki.py
@@ -0,0 +1,148 @@
+"""Wikidata (who wrote what, who influenced whom) and Wikisource (the texts).
+
+Only URL building and parsing of the answers live here; fetching is done by
+`net.Fetcher`, so everything can be tested with recorded answers.
+"""
+
+from __future__ import annotations
+
+import urllib.parse
+
+WIKIDATA_API = "https://www.wikidata.org/w/api.php"
+SPARQL = "https://query.wikidata.org/sparql"
+
+
+def wikisource_api(lang: str) -> str:
+    return f"https://{lang}.wikisource.org/w/api.php"
+
+
+def search_url(name: str) -> str:
+    """Wikidata items whose label matches `name` (first 7)."""
+    q = {
+        "action": "wbsearchentities",
+        "search": name,
+        "language": "en",
+        "type": "item",
+        "limit": "7",
+        "format": "json",
+    }
+    return WIKIDATA_API + "?" + urllib.parse.urlencode(q)
+
+
+def sparql_url(query: str) -> str:
+    return SPARQL + "?" + urllib.parse.urlencode({"query": query, "format": "json"})
+
+
+def search_ids(answer: dict) -> list[str]:
+    """The item ids of a wbsearchentities answer, in order."""
+    return [x["id"] for x in answer.get("search", []) if "id" in x]
+
+
+def person_query(qids: list[str]) -> str:
+    """For each candidate: is it a human, its label, death year, influences."""
+    values = " ".join(f"wd:{q}" for q in qids)
+    return f"""SELECT ?p ?pLabel ?died ?infl ?inflLabel WHERE {{
+  VALUES ?p {{ {values} }}
+  ?p wdt:P31 wd:Q5 .
+  OPTIONAL {{ ?p wdt:P570 ?died . }}
+  OPTIONAL {{ ?p wdt:P737 ?infl . }}
+  SERVICE wikibase:label {{ bd:serviceParam wikibase:language "it,de,en". }}
+}}"""
+
+
+def works_query(qid: str, langs: list[str]) -> str:
+    """Works by `qid` (author of, or notable work) that have a Wikisource page in one
+    of `langs`, with the title of that page."""
+    sites = " ".join(f"<https://{l}.wikisource.org/>" for l in langs)
+    return f"""SELECT DISTINCT ?work ?workLabel ?site ?title WHERE {{
+  {{ ?work wdt:P50 wd:{qid} . }} UNION {{ wd:{qid} wdt:P800 ?work . }}
+  ?page schema:about ?work ; schema:isPartOf ?site ; schema:name ?title .
+  VALUES ?site {{ {sites} }}
+  SERVICE wikibase:label {{ bd:serviceParam wikibase:language "it,de,en". }}
+}}"""
+
+
+def _value(row: dict, key: str) -> str:
+    return row.get(key, {}).get("value", "")
+
+
+def _qid(uri: str) -> str:
+    return uri.rsplit("/", 1)[-1]
+
+
+def parse_persons(answer: dict) -> dict[str, dict]:
+    """qid -> {label, died (year or None), influences [(qid, label)]}."""
+    out: dict[str, dict] = {}
+    for row in answer.get("results", {}).get("bindings", []):
+        q = _qid(_value(row, "p"))
+        p = out.setdefault(q, {"label": _value(row, "pLabel"), "died": None, "influences": []})
+        died = _value(row, "died")
+        if died:
+            # "1832-03-22T00:00:00Z"; a negative year means BCE.
+            year = int(died[: died.index("-", 1)])
+            p["died"] = year if p["died"] is None else min(p["died"], year)
+        infl = _value(row, "infl")
+        if infl:
+            pair = (_qid(infl), _value(row, "inflLabel"))
+            if pair not in p["influences"]:
+                p["influences"].append(pair)
+    return out
+
+
+def parse_works(answer: dict) -> list[dict]:
+    """[{work, label, lang, title}] sorted by language then title."""
+    out = []
+    seen = set()
+    for row in answer.get("results", {}).get("bindings", []):
+        site = _value(row, "site")  # https://de.wikisource.org/
+        lang = urllib.parse.urlsplit(site).hostname.split(".")[0] if site else ""
+        item = (_qid(_value(row, "work")), lang, _value(row, "title"))
+        if item in seen or not item[2]:
+            continue
+        seen.add(item)
+        out.append({"work": item[0], "label": _value(row, "workLabel"), "lang": lang, "title": item[2]})
+    return sorted(out, key=lambda w: (w["lang"], w["title"]))
+
+
+def subpages_url(lang: str, title: str) -> str:
+    """The subpages (chapters) of a Wikisource work: `Title/...`."""
+    q = {
+        "action": "query",
+        "list": "allpages",
+        "apprefix": title.replace(" ", "_") + "/",
+        "apnamespace": "0",
+        "aplimit": "max",
+        "format": "json",
+        "formatversion": "2",
+        "maxlag": "5",
+    }
+    return wikisource_api(lang) + "?" + urllib.parse.urlencode(q)
+
+
+def parse_subpages(answer: dict) -> list[str]:
+    return [p["title"] for p in answer.get("query", {}).get("allpages", [])]
+
+
+def page_url(lang: str, title: str) -> str:
+    """The rendered HTML of one Wikisource page."""
+    q = {
+        "action": "parse",
+        "page": title,
+        "prop": "text",
+        "redirects": "1",
+        "disablelimitreport": "1",
+        "disableeditsection": "1",
+        "format": "json",
+        "formatversion": "2",
+        "maxlag": "5",
+    }
+    return wikisource_api(lang) + "?" + urllib.parse.urlencode(q)
+
+
+def parse_page(answer: dict) -> str:
+    """The HTML of a parse answer ('' if the page does not exist)."""
+    return answer.get("parse", {}).get("text", "")
+
+
+def page_link(lang: str, title: str) -> str:
+    return f"https://{lang}.wikisource.org/wiki/" + urllib.parse.quote(title.replace(" ", "_"))
diff --git a/tools/tests/test_crawl.py b/tools/tests/test_crawl.py
new file mode 100644
index 0000000..84729a2
--- /dev/null
+++ b/tools/tests/test_crawl.py
@@ -0,0 +1,179 @@
+"""Tests of the crawler with recorded answers: no network is used.
+
+Run: uv run --project tools python -m unittest discover -s tools/tests
+"""
+
+import json
+import tempfile
+import unittest
+import urllib.parse
+from pathlib import Path
+
+from monade_tools import cards, crawl, extract, wiki
+from monade_tools.net import Fetcher
+
+PAGE_HTML = """
+<div class="ws-noexport header_box">Navigation: previous | next</div>
+<table><tr><td>Info box</td></tr></table>
+<h2>Erster Teil<span class="mw-editsection">[edit]</span></h2>
+<p>Habe nun, ach! Philosophie,<sup class="reference">[1]</sup> Juristerei und Medizin.</p>
+<span class="pagenum">[12]</span>
+<div class="poem"><p>Ihr naht euch wieder,<br>schwankende Gestalten,<br>die früh sich einst</p></div>
+<div id="toc">Inhalt 1 2 3</div>
+<p style="display:none">hidden</p>
+<ol class="references"><li>a footnote</li></ol>
+<p>Café und  Straße.</p>
+"""
+
+
+def sparql(rows):
+    return {"results": {"bindings": [{k: {"value": v} for k, v in r.items()} for r in rows]}}
+
+
+def uri(q):
+    return f"http://www.wikidata.org/entity/{q}"
+
+
+class FakeWeb:
+    """Answers the crawler's requests from a table, and counts them."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, url, headers):
+        self.calls.append(url)
+        assert "monade-crawler" in headers["User-Agent"]
+        u = urllib.parse.urlsplit(url)
+        q = dict(urllib.parse.parse_qsl(u.query))
+        if u.hostname == "www.wikidata.org":
+            ids = {"Goethe": ["Q5879"], "Calvino": ["Q1", "Q155"]}.get(q["search"], [])
+            return json.dumps({"search": [{"id": i} for i in ids]}).encode()
+        if u.hostname == "query.wikidata.org":
+            text = q["query"]
+            if "wdt:P31 wd:Q5" in text and "Q5879" in text:
+                return json.dumps(
+                    sparql(
+                        [
+                            {"p": uri("Q5879"), "pLabel": "Goethe", "died": "1832-03-22T00:00:00Z", "infl": uri("Q1394"), "inflLabel": "Spinoza"},
+                            {"p": uri("Q5879"), "pLabel": "Goethe", "died": "1832-03-22T00:00:00Z", "infl": uri("Q9312"), "inflLabel": "Kant"},
+                        ]
+                    )
+                ).encode()
+            if "wdt:P31 wd:Q5" in text and "Q155" in text:
+                # Q1 is not a person (only Q155 comes back); Q155 died in 1985.
+                return json.dumps(sparql([{"p": uri("Q155"), "pLabel": "Italo Calvino", "died": "1985-09-19T00:00:00Z"}])).encode()
+            if "wd:Q5879" in text:
+                return json.dumps(
+                    sparql(
+                        [
+                            {"work": uri("Q75"), "workLabel": "Faust", "site": "https://de.wikisource.org/", "title": "Faust I"},
+                            {"work": uri("Q76"), "workLabel": "Leer", "site": "https://de.wikisource.org/", "title": "Leeres Werk"},
+                            {"work": uri("Q75"), "workLabel": "Faust", "site": "https://en.wikisource.org/", "title": "Faust (translation)"},
+                        ]
+                    )
+                ).encode()
+        if u.hostname == "de.wikisource.org":
+            if q["action"] == "query":
+                pages = ["Faust I/Zueignung", "Faust I/Nacht"] if q["apprefix"] == "Faust_I/" else []
+                return json.dumps({"query": {"allpages": [{"title": t} for t in pages]}}).encode()
+            if q["page"] == "Faust I":
+                return json.dumps({"parse": {"text": "<ul><li>Zueignung</li><li>Nacht</li></ul>"}}).encode()
+            if q["page"].startswith("Faust I/"):
+                return json.dumps({"parse": {"text": PAGE_HTML}}).encode()
+            return json.dumps({"parse": {"text": ""}}).encode()
+        raise AssertionError(f"unexpected request {url}")
+
+
+class Crawl(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.dir = Path(self.tmp.name)
+        self.seeds = self.dir / "seeds.toml"
+        self.seeds.write_text(
+            '[[author]]\nsearch = "Goethe"\nlang = ["de"]\n\n[[author]]\nsearch = "Calvino"\nlang = ["it"]\n',
+            encoding="utf-8",
+        )
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def test_public_domain_rule(self):
+        self.assertTrue(crawl.public_domain(1955, 2026))  # Thomas Mann, free since 1 January 2026
+        self.assertFalse(crawl.public_domain(1956, 2026))
+        self.assertFalse(crawl.public_domain(1985, 2026))  # Calvino
+        self.assertFalse(crawl.public_domain(None, 2026))  # no death date: may be alive
+
+    def test_extract_keeps_text_drops_apparatus(self):
+        p = extract.paragraphs(PAGE_HTML)
+        joined = "\n".join(p)
+        self.assertIn("Erster Teil", p)
+        self.assertIn("Habe nun, ach! Philosophie, Juristerei und Medizin.", p)
+        self.assertIn("Ihr naht euch wieder,\nschwankende Gestalten,\ndie früh sich einst", p)
+        self.assertIn("Café und Straße.", p)  # NFC, spaces collapsed
+        for gone in ("[edit]", "[1]", "[12]", "Navigation", "Info box", "Inhalt", "hidden", "footnote"):
+            self.assertNotIn(gone, joined)
+        self.assertEqual(extract.paragraphs("  "), [])
+
+    def test_wikidata_parsing(self):
+        persons = wiki.parse_persons(
+            sparql([{"p": uri("Q1"), "pLabel": "A", "died": "-0399-01-01T00:00:00Z"}])
+        )
+        self.assertEqual(persons["Q1"]["died"], -399)
+        works = wiki.parse_works(
+            sparql(
+                [
+                    {"work": uri("Q2"), "workLabel": "B", "site": "https://it.wikisource.org/", "title": "Zeta"},
+                    {"work": uri("Q3"), "workLabel": "C", "site": "https://it.wikisource.org/", "title": "Alfa"},
+                    {"work": uri("Q3"), "workLabel": "C", "site": "https://it.wikisource.org/", "title": "Alfa"},
+                ]
+            )
+        )
+        self.assertEqual([w["title"] for w in works], ["Alfa", "Zeta"])
+        self.assertEqual(works[0]["lang"], "it")
+
+    def test_full_crawl_then_resume(self):
+        web = FakeWeb()
+        root = self.dir / "biblioteca"
+        f = Fetcher(root / "cache", pause=0, opener=web)
+        counts = crawl.run(self.seeds, root, fetch=f, year=2026)
+        self.assertEqual(counts["authors"], 1)
+        self.assertEqual(counts["works"], 1)  # Faust I; the empty work and the translation are not taken
+        lib = crawl.Library(root)
+        works = lib.rows("works.jsonl")
+        self.assertEqual(works[0]["work_id"], "de-Q75")
+        self.assertEqual(works[0]["pages"], 3)
+        texts = [json.loads(l) for l in (root / works[0]["path"]).read_text(encoding="utf-8").splitlines()]
+        self.assertEqual({t["page"] for t in texts}, {"Faust I/Zueignung", "Faust I/Nacht"})  # index page skipped
+        refused = lib.rows("refused.jsonl")
+        self.assertTrue(any("1985" in r["why"] for r in refused))  # Calvino
+        self.assertTrue(any(r["why"] == "no text found" for r in refused))
+        edges = lib.rows("edges.jsonl")
+        self.assertIn({"from": "Q5879", "rel": "influenced_by", "to": "Q1394", "from_label": "Goethe", "to_label": "Spinoza"}, edges)
+        self.assertEqual(len(lib.rows("lessons.jsonl")), 1)
+        lock = json.loads((root / "seeds.lock.json").read_text(encoding="utf-8"))
+        self.assertEqual(lock["Calvino"]["qid"], "Q155")  # Q1 is not a person
+        card = cards.read(root / "card.json")
+        self.assertEqual(cards.problems(card, root), [])
+        self.assertIn("Goethe", crawl.status(root))
+        # A second run: nothing new, nothing asked twice, no duplicate rows.
+        before = len(web.calls)
+        again = crawl.run(self.seeds, root, fetch=Fetcher(root / "cache", pause=0, opener=web), year=2026)
+        self.assertEqual(again["works"], 0)
+        self.assertEqual(len(web.calls), before)
+        self.assertEqual(len(lib.rows("works.jsonl")), 1)
+        self.assertEqual(len(lib.rows("authors.jsonl")), 1)
+        self.assertEqual(len(lib.rows("refused.jsonl")), len(refused))  # refusals recorded once
+
+    def test_time_budget_stops(self):
+        root = self.dir / "b2"
+        counts = crawl.run(self.seeds, root, fetch=Fetcher(root / "cache", pause=0, opener=FakeWeb()), minutes=0, year=2026)
+        self.assertEqual(counts["works"], 0)
+
+    def test_seeds_of_the_project_are_valid(self):
+        seeds = crawl.read_seeds(Path(__file__).resolve().parents[1] / "seeds.toml")
+        self.assertEqual(len(seeds), 10)
+        self.assertTrue(all(set(s["lang"]) <= {"it", "de", "en"} for s in seeds))
+
+
+if __name__ == "__main__":
+    unittest.main()
